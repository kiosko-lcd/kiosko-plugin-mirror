{
  "manifest": 1,
  "id": "mirror",
  "package": "kiosko-plugin-mirror",
  "name": {
    "en": "Mirror cards",
    "es": "Tarjetas Mirror",
    "zh-Hant": "Mirror 卡片",
    "zh-Hans": "Mirror 卡片"
  },
  "version": "0.2.1",
  "description": {
    "en": "MagicMirror²-style cards: countdown, compliments, today and tomorrow, now playing, on this day, air quality, earthquakes, rain radar and traffic.",
    "es": "Tarjetas al estilo de MagicMirror²: cuenta atrás, frases, hoy y mañana, lo que suena, tal día como hoy, calidad del aire, terremotos, radar de lluvia y tráfico.",
    "zh-Hant": "MagicMirror² 風格的卡片：倒數、讚美、今天與明天、正在播放、歷史上的今天、空氣品質、地震、降雨雷達與交通。",
    "zh-Hans": "MagicMirror² 风格的卡片：倒计时、夸夸、今天和明天、正在播放、历史上的今天、空气质量、地震、降雨雷达和路况。"
  },
  "author": "Kiosko",
  "license": "MIT",
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-mirror#readme",
  "repository": "https://github.com/kiosko-lcd/kiosko-plugin-mirror.git",
  "icon": "layout-grid",
  "sdk": "^0.2.0",
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "languages": [
    "en",
    "es",
    "zh-Hant",
    "zh-Hans"
  ],
  "categories": [
    "time",
    "fun",
    "productivity",
    "media",
    "info"
  ],
  "tags": [
    "magicmirror",
    "dates",
    "motivation",
    "todo",
    "spotify",
    "mpris",
    "history",
    "wikipedia",
    "weather",
    "pollen",
    "seismic",
    "radar",
    "map",
    "traffic",
    "roads"
  ],
  "permissions": {
    "network": [
      "air-quality-api.open-meteo.com",
      "www.seismicportal.eu",
      "api.rainviewer.com",
      "tile.openstreetmap.org",
      "nominatim.openstreetmap.org",
      "*.wikipedia.org",
      "api.tomtom.com"
    ],
    "exec": [
      "gdbus",
      "glab"
    ],
    "devices": [
      "mpris"
    ]
  },
  "riskyOptions": [
    {
      "path": "mirror/tasks: file",
      "risk": [
        "path"
      ],
      "secret": false
    },
    {
      "path": "mirror/tasks: bin",
      "risk": [
        "exec"
      ],
      "secret": false
    },
    {
      "path": "mirror/trafficmap: apiKey",
      "risk": [],
      "secret": true
    }
  ],
  "requires": [],
  "optional": [],
  "widgets": [
    {
      "type": "mirror/countdown",
      "name": {
        "en": "Countdown",
        "es": "Cuenta atrás",
        "zh-Hant": "倒數",
        "zh-Hans": "倒计时"
      },
      "description": {
        "en": "Days left until your important dates, nearest first. Birthdays and anniversaries come back every year.",
        "es": "Los días que faltan para tus fechas importantes, la más cercana primero. Cumpleaños y aniversarios vuelven cada año.",
        "zh-Hant": "距離重要日期還有幾天，最近的排在前面。生日和紀念日每年都會再出現。",
        "zh-Hans": "距离重要日期还有几天，最近的排在前面。生日和纪念日每年都会再出现。"
      },
      "icon": "hourglass",
      "category": "time",
      "tags": [
        "magicmirror",
        "dates"
      ],
      "size": {
        "min": {
          "w": 240,
          "h": 100
        },
        "preferred": {
          "w": 400,
          "h": 300
        }
      },
      "chrome": "card",
      "sources": [],
      "options": {
        "default": {
          "events": [],
          "rows": 4,
          "warnDays": 7,
          "alertDays": 1
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "events": {
            "title": "Dates",
            "description": "Past dates hide themselves; yearly ones come back.",
            "default": [],
            "x-ui": {
              "label": {
                "en": "Dates",
                "es": "Fechas",
                "zh-Hant": "日期",
                "zh-Hans": "日期"
              },
              "help": {
                "en": "Past dates hide themselves; yearly ones come back.",
                "es": "Las fechas pasadas desaparecen solas; las de cada año vuelven.",
                "zh-Hant": "過去的日期會自動隱藏；每年的日期會再次出現。",
                "zh-Hans": "过去的日期会自动隐藏；每年的日期会再次出现。"
              }
            },
            "type": "array",
            "items": {
              "default": {
                "name": "",
                "date": "",
                "yearly": false
              },
              "x-ui": {},
              "type": "object",
              "properties": {
                "name": {
                  "title": "What",
                  "default": "",
                  "x-ui": {
                    "label": {
                      "en": "What",
                      "es": "Qué",
                      "zh-Hant": "事項",
                      "zh-Hans": "事项"
                    },
                    "placeholder": "Holidays"
                  },
                  "type": "string"
                },
                "date": {
                  "title": "Date",
                  "default": "",
                  "x-ui": {
                    "label": {
                      "en": "Date",
                      "es": "Fecha",
                      "zh-Hant": "日期",
                      "zh-Hans": "日期"
                    },
                    "placeholder": "2027-01-25",
                    "format": "date"
                  },
                  "type": "string",
                  "format": "date"
                },
                "yearly": {
                  "title": "Every year",
                  "description": "Birthdays and anniversaries: the year of the date doesn’t matter.",
                  "default": false,
                  "x-ui": {
                    "label": {
                      "en": "Every year",
                      "es": "Cada año",
                      "zh-Hant": "每年",
                      "zh-Hans": "每年"
                    },
                    "help": {
                      "en": "Birthdays and anniversaries: the year of the date doesn’t matter.",
                      "es": "Cumpleaños y aniversarios: el año de la fecha da igual.",
                      "zh-Hant": "生日和紀念日：日期的年份不影響。",
                      "zh-Hans": "生日和纪念日：日期中的年份无所谓。"
                    }
                  },
                  "type": "boolean"
                }
              }
            }
          },
          "rows": {
            "title": "Rows",
            "description": "0 = as many as fit. A number shows that many, in rows of a readable size (fewer when the tile is too small for them); the rest are counted in \"+N more\".",
            "default": 4,
            "x-ui": {
              "label": {
                "en": "Rows",
                "es": "Filas",
                "zh-Hant": "列數",
                "zh-Hans": "行数"
              },
              "help": {
                "en": "0 = as many as fit. A number shows that many, in rows of a readable size (fewer when the tile is too small for them); the rest are counted in \"+N more\".",
                "es": "0 = las que quepan. Con un número se ven esas, en filas de un tamaño legible (menos si la tesela no da para ellas); el resto se cuenta en «+N más».",
                "zh-Hant": "0 = 盡量放滿。填數字則顯示該數量，並以易讀的大小排列（方格太小時會減少）；其餘的計入「還有 N 個」。",
                "zh-Hans": "0 = 尽量放满。填数字则显示该数量，并以易读的大小排列（格子太小时会减少）；其余的计入“还有 N 个”。"
              }
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "warnDays": {
            "title": "Amber from (days before)",
            "default": 7,
            "x-ui": {
              "label": {
                "en": "Amber from (days before)",
                "es": "Ámbar desde (días antes)",
                "zh-Hant": "琥珀色起始（提前天數）",
                "zh-Hans": "琥珀色起始（提前天数）"
              },
              "unit": "d"
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "alertDays": {
            "title": "Red from (days before)",
            "description": "0: only on the day.",
            "default": 1,
            "x-ui": {
              "label": {
                "en": "Red from (days before)",
                "es": "Rojo desde (días antes)",
                "zh-Hant": "紅色起始（提前天數）",
                "zh-Hans": "红色起始（提前天数）"
              },
              "help": {
                "en": "0: only on the day.",
                "es": "0: sólo el mismo día.",
                "zh-Hant": "0：只在當天。",
                "zh-Hans": "0：仅当天。"
              },
              "unit": "d"
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          }
        }
      },
      "screenshot": "docs/countdown.png",
      "animated": false,
      "urgent": false
    },
