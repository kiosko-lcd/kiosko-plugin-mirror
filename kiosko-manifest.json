{
  "manifest": 1,
  "id": "mirror",
  "package": "kiosko-plugin-mirror",
  "name": {
    "en": "Mirror cards",
    "es": "Tarjetas Mirror"
  },
  "version": "0.2.1",
  "description": {
    "en": "MagicMirror²-style cards: countdown, compliments, today and tomorrow, now playing, on this day, air quality, earthquakes, rain radar and traffic.",
    "es": "Tarjetas al estilo de MagicMirror²: cuenta atrás, frases, hoy y mañana, lo que suena, tal día como hoy, calidad del aire, terremotos, radar de lluvia y tráfico."
  },
  "author": "Kiosko",
  "license": "MIT",
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-mirror#readme",
  "repository": "https://github.com/kiosko-lcd/kiosko-plugin-mirror.git",
  "icon": "layout-grid",
  "sdk": "^0.2.0",
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "languages": [
    "en",
    "es"
  ],
  "categories": [
    "time",
    "fun",
    "productivity",
    "media",
    "info"
  ],
  "tags": [
    "magicmirror",
    "dates",
    "motivation",
    "todo",
    "spotify",
    "mpris",
    "history",
    "wikipedia",
    "weather",
    "pollen",
    "seismic",
    "radar",
    "map",
    "traffic",
    "roads"
  ],
  "permissions": {
    "network": [
      "air-quality-api.open-meteo.com",
      "www.seismicportal.eu",
      "api.rainviewer.com",
      "tile.openstreetmap.org",
      "nominatim.openstreetmap.org",
      "*.wikipedia.org",
      "api.tomtom.com"
    ],
    "exec": [
      "gdbus",
      "glab"
    ],
    "devices": [
      "mpris"
    ]
  },
  "riskyOptions": [
    {
      "path": "mirror/tasks: file",
      "risk": [
        "path"
      ],
      "secret": false
    },
    {
      "path": "mirror/tasks: bin",
      "risk": [
        "exec"
      ],
      "secret": false
    },
    {
      "path": "mirror/trafficmap: apiKey",
      "risk": [],
      "secret": true
    }
  ],
  "requires": [],
  "optional": [],
  "widgets": [
    {
      "type": "mirror/countdown",
      "name": {
        "en": "Countdown",
        "es": "Cuenta atrás"
      },
      "description": {
        "en": "Days left until your important dates, nearest first. Birthdays and anniversaries come back every year.",
        "es": "Los días que faltan para tus fechas importantes, la más cercana primero. Cumpleaños y aniversarios vuelven cada año."
      },
      "icon": "hourglass",
      "category": "time",
      "tags": [
        "magicmirror",
        "dates"
      ],
      "size": {
        "min": {
          "w": 240,
          "h": 100
        },
        "preferred": {
          "w": 400,
          "h": 300
        }
      },
      "chrome": "card",
      "sources": [],
      "options": {
        "default": {
          "events": [],
          "rows": 4,
          "warnDays": 7,
          "alertDays": 1
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "events": {
            "title": "Dates",
            "description": "Past dates hide themselves; yearly ones come back.",
            "default": [],
            "x-ui": {
              "label": {
                "en": "Dates",
                "es": "Fechas"
              },
              "help": {
                "en": "Past dates hide themselves; yearly ones come back.",
                "es": "Las fechas pasadas desaparecen solas; las de cada año vuelven."
              }
            },
            "type": "array",
            "items": {
              "default": {
                "name": "",
                "date": "",
                "yearly": false
              },
              "x-ui": {},
              "type": "object",
              "properties": {
                "name": {
                  "title": "What",
                  "default": "",
                  "x-ui": {
                    "label": {
                      "en": "What",
                      "es": "Qué"
                    },
                    "placeholder": "Holidays"
                  },
                  "type": "string"
                },
                "date": {
                  "title": "Date",
                  "default": "",
                  "x-ui": {
                    "label": {
                      "en": "Date",
                      "es": "Fecha"
                    },
                    "placeholder": "2027-01-25",
                    "format": "date"
                  },
                  "type": "string",
                  "format": "date"
                },
                "yearly": {
                  "title": "Every year",
                  "description": "Birthdays and anniversaries: the year of the date doesn’t matter.",
                  "default": false,
                  "x-ui": {
                    "label": {
                      "en": "Every year",
                      "es": "Cada año"
                    },
                    "help": {
                      "en": "Birthdays and anniversaries: the year of the date doesn’t matter.",
                      "es": "Cumpleaños y aniversarios: el año de la fecha da igual."
                    }
                  },
                  "type": "boolean"
                }
              }
            }
          },
          "rows": {
            "title": "Rows",
            "description": "0 = as many as fit. A number shows that many, in rows of a readable size (fewer when the tile is too small for them); the rest are counted in \"+N more\".",
            "default": 4,
            "x-ui": {
              "label": {
                "en": "Rows",
                "es": "Filas"
              },
              "help": {
                "en": "0 = as many as fit. A number shows that many, in rows of a readable size (fewer when the tile is too small for them); the rest are counted in \"+N more\".",
                "es": "0 = las que quepan. Con un número se ven esas, en filas de un tamaño legible (menos si la tesela no da para ellas); el resto se cuenta en «+N más»."
              }
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "warnDays": {
            "title": "Amber from (days before)",
            "default": 7,
            "x-ui": {
              "label": {
                "en": "Amber from (days before)",
                "es": "Ámbar desde (días antes)"
              },
              "unit": "d"
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "alertDays": {
            "title": "Red from (days before)",
            "description": "0: only on the day.",
            "default": 1,
            "x-ui": {
              "label": {
                "en": "Red from (days before)",
                "es": "Rojo desde (días antes)"
              },
              "help": {
                "en": "0: only on the day.",
                "es": "0: sólo el mismo día."
              },
              "unit": "d"
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          }
        }
      },
      "screenshot": "docs/countdown.png",
      "animated": false,
      "urgent": false
    },
