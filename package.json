{
  "name": "kiosko-plugin-mirror",
  "version": "0.1.1",
  "description": "MagicMirror²-style cards: countdown, compliments, tasks, now playing, on this day, air quality, earthquakes, rain radar and traffic.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly",
  "keywords": [
    "kiosko",
    "kiosko-plugin",
    "lcd",
    "widgets",
    "time",
    "fun",
    "productivity",
    "media",
    "info"
  ],
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-mirror#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko-plugin-mirror.git"
  },
  "bugs": {
    "url": "https://github.com/kiosko-lcd/kiosko-plugin-mirror/issues"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "kiosko": {
    "plugin": "./dist/index.js",
    "id": "mirror"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --conditions=source --test \"src/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@kiosko/sdk": "^0.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
